    {
      "id": "d-pasar",
      "title": "Bargaining at a market",
      "situation": "shopping",
      "intro": "You browse batik shirts at a market stall in Yogyakarta.",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "npc",
          "native": "Selamat siang. Cari apa?",
          "reading": "seh-lah-maht see-ahng. chah-ree ah-pah",
          "english": "Good day. What are you looking for?",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-lihat-lihat"
            },
            {
              "next": "n2",
              "good": true,
              "native": "Saya cari baju batik",
              "reading": "sah-yah chah-ree bah-joo bah-teek",
              "english": "I'm looking for a batik shirt"
            },
            {
              "next": "n1b",
              "good": false,
              "phraseId": "p-maaf",
              "feedback": "No need to apologise. Say what you want, or that you are just looking."
            }
          ]
        },
        "n1b": {
          "speaker": "npc",
          "native": "Silakan lihat-lihat.",
          "reading": "see-lah-kahn lee-haht lee-haht",
          "english": "Please have a look.",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-lihat-lihat"
            },
            {
              "next": "n2",
              "good": true,
              "native": "Saya cari baju batik",
              "reading": "sah-yah chah-ree bah-joo bah-teek",
              "english": "I'm looking for a batik shirt"
            }
          ]
        },
        "n2": {
          "speaker": "npc",
          "native": "Ini batik asli. Bagus, kan?",
          "reading": "ee-nee bah-teek ah-slee. bah-goos, kahn",
          "english": "This is genuine batik. Nice, isn't it?",
          "replies": [
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-berapa"
            },
            {
