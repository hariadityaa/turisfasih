{
  "schemaVersion": 1,
  "dialogues": [
    {
      "id": "d-warung",
      "title": "Eating at a warung",
      "situation": "food",
      "intro": "You stop at a small warung in Yogyakarta. The owner waves you in.",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "npc",
          "native": "Selamat datang. Makan di sini atau dibungkus?",
          "reading": "seh-lah-maht dah-tahng. mah-kahn dee see-nee ah-tah-oo dee-boong-koos",
          "english": "Welcome. Eat here or take away?",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-makan-di-sini"
            },
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-dibungkus"
            },
            {
              "next": "n1b",
              "good": false,
              "phraseId": "p-sampai-jumpa",
              "feedback": "That means goodbye. You just arrived."
            }
          ]
        },
        "n1b": {
          "speaker": "npc",
          "native": "Maaf, makan di sini atau dibungkus?",
          "reading": "mah-ahf, mah-kahn dee see-nee ah-tah-oo dee-boong-koos",
          "english": "Sorry, eat here or take away?",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-makan-di-sini"
            },
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-dibungkus"
            }
          ]
        },
        "n2": {
          "speaker": "npc",
          "native": "Silakan. Mau pesan apa?",
          "reading": "see-lah-kahn. mah-oo peh-sahn ah-pah",
          "english": "Please. What would you like to order?",
          "replies": [
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-nasi-goreng"
            },
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-rekomendasi"
            },
            {
              "next": "n2b",
              "good": false,
              "phraseId": "p-dimana-toilet",
              "feedback": "Not yet. You still need to order."
            }
          ]
        },
        "n2b": {
          "speaker": "npc",
          "native": "Toilet ada di belakang. Mau pesan apa?",
          "reading": "toy-leht ah-dah dee beh-lah-kahng. mah-oo peh-sahn ah-pah",
          "english": "The toilet is at the back. What would you like?",
          "replies": [
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-nasi-goreng"
            },
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-minta-ini"
            }
          ]
        },
        "n3": {
          "speaker": "npc",
          "native": "Mau pedas atau tidak?",
          "reading": "mah-oo peh-dahs ah-tah-oo tee-dahk",
          "english": "Spicy or not spicy?",
          "replies": [
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-sedikit-pedas"
            },
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-tidak-pedas"
            },
            {
              "next": "n3b",
              "good": false,
              "phraseId": "p-terima-kasih",
              "feedback": "Polite, but it doesn't answer the question."
            }
          ]
        },
        "n3b": {
          "speaker": "npc",
          "native": "Pedas atau tidak pedas?",
          "reading": "peh-dahs ah-tah-oo tee-dahk peh-dahs",
          "english": "Spicy or not spicy?",
          "replies": [
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-sedikit-pedas"
            },
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-tidak-pedas"
            }
          ]
        },
        "n4": {
          "speaker": "npc",
          "native": "Minumnya apa?",
          "reading": "mee-noom-nyah ah-pah",
          "english": "And to drink?",
          "replies": [
            {
              "next": "n5",
              "good": true,
              "phraseId": "p-air-putih"
            },
            {
              "next": "n5",
              "good": true,
              "native": "Es teh manis, tolong",
              "reading": "ehs teh mah-nees, toh-lohng",
              "english": "Sweet iced tea, please"
            },
            {
              "next": "n5",
              "good": true,
              "native": "Tidak usah, terima kasih",
              "reading": "tee-dahk oo-sah, teh-ree-mah kah-see",
              "english": "No need, thank you"
            }
          ]
        },
        "n5": {
          "speaker": "npc",
          "native": "Ini pesanannya. Selamat makan!",
          "reading": "ee-nee peh-sah-nahn-nyah. seh-lah-maht mah-kahn",
          "english": "Here's your order. Enjoy your meal!",
          "replies": [
            {
              "next": "n6",
              "good": true,
              "phraseId": "p-terima-kasih"
            },
            {
              "next": "n6",
              "good": true,
              "phraseId": "p-enak"
            }
          ]
        },
        "n6": {
          "speaker": "npc",
          "native": "Sudah selesai? Semuanya tiga puluh lima ribu rupiah.",
          "reading": "soo-dah seh-leh-sie? seh-moo-ah-nyah tee-gah poo-loo lee-mah ree-boo roo-pee-ah",
          "english": "All done? That's 35,000 rupiah altogether.",
          "replies": [
            {
              "next": "n7",
              "good": true,
              "phraseId": "p-bayar-tunai"
            },
            {
              "next": "n7",
              "good": true,
              "phraseId": "p-bayar-kartu"
            },
            {
              "next": "n6b",
              "good": false,
              "phraseId": "p-ambil-ini",
              "feedback": "You've already ordered. They are asking you to pay."
            }
          ]
        },
        "n6b": {
          "speaker": "npc",
          "native": "Semuanya tiga puluh lima ribu rupiah.",
          "reading": "seh-moo-ah-nyah tee-gah poo-loo lee-mah ree-boo roo-pee-ah",
          "english": "That's 35,000 rupiah altogether.",
          "replies": [
            {
              "next": "n7",
              "good": true,
              "phraseId": "p-bayar-tunai"
            },
            {
              "next": "n7",
              "good": true,
              "phraseId": "p-bayar-kartu"
            }
          ]
        },
        "n7": {
          "speaker": "npc",
          "native": "Terima kasih. Datang lagi, ya!",
          "reading": "teh-ree-mah kah-see. dah-tahng lah-gee, yah",
          "english": "Thank you. Come again!",
          "end": true
        }
      }
    },
    {
      "id": "d-taksi",
      "title": "Taking a taxi",
      "situation": "transport",
      "intro": "You wave down a taxi outside the station in Jakarta.",
      "start": "n1",
      "nodes": {
        "n1": {
          "speaker": "npc",
          "native": "Selamat siang. Mau ke mana?",
          "reading": "seh-lah-maht see-ahng. mah-oo keh mah-nah",
          "english": "Good day. Where to?",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-ke-alamat"
            },
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-ke-bandara"
            },
            {
              "next": "n1b",
              "good": false,
              "phraseId": "p-sama-sama",
              "feedback": "That means 'you're welcome'. He asked where you are going."
            }
          ]
        },
        "n1b": {
          "speaker": "npc",
          "native": "Maaf, mau ke mana?",
          "reading": "mah-ahf, mah-oo keh mah-nah",
          "english": "Sorry, where to?",
          "replies": [
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-ke-alamat"
            },
            {
              "next": "n2",
              "good": true,
              "phraseId": "p-ke-bandara"
            }
          ]
        },
        "n2": {
          "speaker": "npc",
          "native": "Baik. Pakai argo atau harga tetap?",
          "reading": "bah-eek. pah-kie ar-goh ah-tah-oo hahr-gah teh-tahp",
          "english": "OK. Meter or fixed price?",
          "replies": [
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-argo"
            },
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-ongkos"
            },
            {
              "next": "n2b",
              "good": false,
              "phraseId": "p-dibungkus",
              "feedback": "That's for food. He is asking about the meter or a fixed price."
            }
          ]
        },
        "n2b": {
          "speaker": "npc",
          "native": "Pakai argo, ya?",
          "reading": "pah-kie ar-goh, yah",
          "english": "Use the meter, OK?",
          "replies": [
            {
              "next": "n3",
              "good": true,
              "phraseId": "p-argo"
            },
            {
              "next": "n3",
              "good": true,
              "native": "Ya, pakai argo",
              "reading": "yah, pah-kie ar-goh",
              "english": "Yes, use the meter"
            }
          ]
        },
        "n3": {
          "speaker": "npc",
          "native": "Macet sekali hari ini. Mungkin tiga puluh menit.",
          "reading": "mah-chet seh-kah-lee hah-ree ee-nee. moong-kin tee-gah poo-loo meh-neet",
          "english": "Traffic is heavy today. Maybe thirty minutes.",
          "replies": [
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-tidak-apa-apa"
            },
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-apakah-jauh"
            },
            {
              "next": "n3b",
              "good": false,
              "phraseId": "p-terlalu-mahal",
              "feedback": "He didn't mention a price. He told you about the traffic."
            }
          ]
        },
        "n3b": {
          "speaker": "npc",
          "native": "Maaf, jalannya macet. Tidak apa-apa?",
          "reading": "mah-ahf, jah-lahn-nyah mah-chet. tee-dahk ah-pah ah-pah",
          "english": "Sorry, the roads are jammed. Is that OK?",
          "replies": [
            {
              "next": "n4",
              "good": true,
              "phraseId": "p-tidak-apa-apa"
            },
            {
              "next": "n4",
              "good": true,
              "native": "Baik, silakan",
              "reading": "bah-eek, see-lah-kahn",
              "english": "OK, go ahead"
            }
          ]
        },
        "n4": {
          "speaker": "npc",
          "native": "Kita sudah sampai.",
          "reading": "kee-tah soo-dah sahm-pie",
          "english": "We've arrived.",
          "replies": [
            {
              "next": "n5",
              "good": true,
              "phraseId": "p-berhenti-sini"
            },
            {
              "next": "n5",
              "good": true,
              "phraseId": "p-ongkos"
            },
            {
              "next": "n4b",
              "good": false,
              "phraseId": "p-tersesat",
              "feedback": "You are at your stop. You aren't lost."
            }
          ]
        },
        "n4b": {
          "speaker": "npc",
          "native": "Sudah sampai, ya.",
          "reading": "soo-dah sahm-pie, yah",
          "english": "We're here.",
          "replies": [
            {
              "next": "n5",
              "good": true,
              "phraseId": "p-berhenti-sini"
            },
            {
              "next": "n5",
              "good": true,
              "phraseId": "p-ongkos"
            }
          ]
        },
        "n5": {
          "speaker": "npc",
          "native": "Delapan puluh lima ribu rupiah.",
          "reading": "deh-lah-pahn poo-loo lee-mah ree-boo roo-pee-ah",
          "english": "85,000 rupiah.",
          "replies": [
            {
              "next": "n6",
              "good": true,
              "phraseId": "p-bayar-tunai"
            },
            {
              "next": "n6",
              "good": true,
              "phraseId": "p-qris"
            }
          ]
        },
        "n6": {
          "speaker": "npc",
          "native": "Terima kasih. Hati-hati, ya!",
          "reading": "teh-ree-mah kah-see. hah-tee hah-tee, yah",
          "english": "Thank you. Take care!",
          "end": true
        }
      }
    },
    {
      "id": "d-hotel",
      "title": "Checking in at a hotel",
      "situation": "hotel",
