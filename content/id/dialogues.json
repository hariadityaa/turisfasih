            {
              "next": "n4",
              "good": true,
              "phraseId": "p-paspor"
            },
            {
              "next": "n4",
              "good": true,
              "native": "Ya, ini dia",
              "reading": "yah, ee-nee dee-ah",
              "english": "Yes, here it is"
