{
  "name": "turisfasih",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run validate && vite build",
    "build:preview": "BASE_PATH=./ vite build --outDir dist-preview",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit",
    "validate": "tsx scripts/validate.ts",
    "test": "vitest run",
    "e2e": "node e2e/back-links.mjs && node e2e/ai-words.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
