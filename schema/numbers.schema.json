{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "range",
    "words",
    "multipliers",
    "separator",
    "priceDrill"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "words": {
      "type": "object",
      "description": "Words for exact values, keyed by number as a string. Must cover 0..9 at minimum.",
      "patternProperties": {
        "^\\d+$": {
          "type": "object",
          "required": [
            "native",
            "reading"
          ],
          "additionalProperties": false,
          "properties": {
            "native": {
              "type": "string",
              "minLength": 1
            },
            "reading": {
              "type": "string",
              "minLength": 1
            },
            "speak": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "multipliers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "native",
          "reading",
          "omitOne"
        ],
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 2
          },
          "native": {
            "type": "string",
            "minLength": 1
          },
          "reading": {
            "type": "string",
            "minLength": 1
          },
          "speak": {
            "type": "string",
            "minLength": 1
          },
          "omitOne": {
            "description": "Drop the quantity 1 before this multiplier. \"leading\" drops it only at the start of the number.",
            "enum": [true, false, "leading"]
          }
        }
      }
    },
    "overrides": {
      "type": "object",
      "description": "Irregular readings for an exact multiple (e.g. 300) used as a group.",
      "patternProperties": {
        "^\\d+$": {
          "type": "object",
          "required": [
            "native",
            "reading"
          ],
          "additionalProperties": false,
          "properties": {
            "native": {
              "type": "string",
              "minLength": 1
            },
            "reading": {
              "type": "string",
              "minLength": 1
            },
            "speak": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    },
    "zero": {
      "type": "object",
      "description": "Word said where a place is skipped, e.g. Mandarin 零 in 一百零五.",
      "required": ["native", "reading"],
      "additionalProperties": false,
      "properties": {
        "native": { "type": "string", "minLength": 1 },
        "reading": { "type": "string", "minLength": 1 },
        "speak": { "type": "string", "minLength": 1 }
      }
    },
    "separator": {
      "type": "string"
    },
    "nativeSeparator": {
      "type": "string",
      "description": "Put between native parts and between a quantity and its multiplier, e.g. \" \" for \"dua puluh lima ribu\". Readings then use separator in those places too. Omit to join native parts with no gap."
    },
    "priceDrill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "step"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "step": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
